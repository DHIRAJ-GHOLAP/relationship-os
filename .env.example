# ==============================================================================
# RELATIONSHIP OS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE: Never commit real secrets or credentials to source control.
# Copy this file to .env and configure appropriate values for your environment.

# ------------------------------------------------------------------------------
# APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
APP_NAME="Relationship OS"
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy secret for signing JWTs and session tokens
SESSION_SECRET="CHANGE_ME_IN_PRODUCTION_MINIMUM_32_CHARACTERS_LONG"
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENROLLMENT_TOKEN_EXPIRE_HOURS=24
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ------------------------------------------------------------------------------
# DATABASE & CACHE
# ------------------------------------------------------------------------------
# SQLite default for dev/test: sqlite+aiosqlite:///./relationship_os.db
# PostgreSQL for production: postgresql+asyncpg://user:pass@localhost:5432/relationship_os
DATABASE_URL="sqlite+aiosqlite:///./relationship_os.db"
DATABASE_ECHO=false

# Redis URL for presence, rate-limiting, and distributed locking (falls back to memory if empty)
REDIS_URL=""

# ------------------------------------------------------------------------------
# INTEGRATIONS: DISCORD
# ------------------------------------------------------------------------------
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN="CHANGE_ME_DISCORD_BOT_TOKEN"
DISCORD_CHANNEL_ID="CHANGE_ME_CHANNEL_ID"
DISCORD_GUILD_ID="CHANGE_ME_GUILD_ID"
DISCORD_OWNER_USER_ID="CHANGE_ME_OWNER_USER_ID"
DISCORD_WEBHOOK_URL=""

# ------------------------------------------------------------------------------
# INTEGRATIONS: WEBHOOK
# ------------------------------------------------------------------------------
WEBHOOK_ENABLED=false
WEBHOOK_SIGNING_SECRET="CHANGE_ME_WEBHOOK_HMAC_SECRET"
WEBHOOK_MAX_RETRIES=5
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_ALLOW_LOCALHOST=false

# ------------------------------------------------------------------------------
# INTEGRATIONS: SIGNAL (OPTIONAL BRIDGE)
# ------------------------------------------------------------------------------
SIGNAL_ENABLED=false
SIGNAL_BRIDGE_URL=""
SIGNAL_BRIDGE_TOKEN=""
SIGNAL_RECIPIENT_NUMBER=""

# ------------------------------------------------------------------------------
# RATE LIMITING & ABUSE PROTECTION
# ------------------------------------------------------------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_MESSAGES_PER_MINUTE=60
MAX_MESSAGE_LENGTH=4000
MAX_ATTACHMENT_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# BRANDING & PERSONALIZATION
# ------------------------------------------------------------------------------
ROOM_NAME="Private Room ♥"
OWNER_DISPLAY_NAME="Owner"
RECIPIENT_DISPLAY_NAME="Recipient"
WELCOME_MESSAGE="Welcome to our private room."
THEME_ACCENT="#e11d48"
